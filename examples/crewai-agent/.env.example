OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini      # optional — overrides the default model used by the agents

# OSS-first: defaults to a local self-hosted ZizkaDB. No API key needed for localhost.
ZIZKADB_HOST=http://localhost:8000
ZIZKADB_AGENT=crewai-research
# ZIZKADB_API_KEY=zizkadb_live_xxxx   # only for a remote/cloud instance
