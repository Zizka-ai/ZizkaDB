# LiveKit Cloud (free tier — rooms/WebRTC only, no agent deploy needed)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI Realtime (voice brain via livekit-plugins-openai)
OPENAI_API_KEY=
# OPENAI_VOICE=coral

# ZizkaDB self-host (Docker quickstart)
ZIZKADB_HOST=http://localhost:8000
ZIZKADB_AGENT=support-voice
# ZIZKADB_DASHBOARD_URL=http://localhost:3001/dashboard/activity

# Must match ZIZKADB_AGENT — used by web_server.py for agent dispatch
AGENT_NAME=support-voice

# Local browser UI (python web_server.py)
WEB_PORT=8080

# Managed ZizkaDB cloud instead of self-host:
# ZIZKADB_API_KEY=zizkadb_live_xxxx
